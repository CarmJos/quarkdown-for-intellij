<idea-plugin>
    <id>cc.carm.plugin.intellij.quarkdown</id>
    <name>Quarkdown</name>
    <vendor>CarmJos</vendor>
    <description>Quarkdown language support for JetBrains IntelliJ Platform.</description>

    <depends>org.intellij.intelliLang</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Quarkdown"
                  implementationClass="cc.carm.plugin.intellij.quarkdown.QuarkdownFileType"
                  fieldName="INSTANCE"
                  language="Quarkdown"
                  extensions="qd"/>

        <internalFileTemplate name="Quarkdown Empty"/>
        <internalFileTemplate name="Quarkdown Example"/>

        <projectConfigurable
                parentId="language"
                id="Settings.Language.Quarkdown"
                instance="cc.carm.plugin.intellij.quarkdown.settings.QuarkdownSettingsConfigurable"
                displayName="Quarkdown"/>

        <projectConfigurable
                parentId="Settings.Language.Quarkdown"
                id="Settings.Language.Quarkdown.EditorAppearance"
                instance="cc.carm.plugin.intellij.quarkdown.settings.QuarkdownEditorAppearanceConfigurable"
                displayName="Editor Appearance"/>

        <postStartupActivity implementation="cc.carm.plugin.intellij.quarkdown.QuarkdownStartupActivity"/>

        <completion.contributor
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.completion.QuarkdownCompletionContributor"/>

        <completion.contributor
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.completion.CodeBlockLanguageCompletionContributor"/>

        <!-- Allow the completion popup to appear in .qd files (do not skip autopopup) -->
        <completion.confidence
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.completion.QuarkdownCompletionConfidence"/>

        <!-- Quick Documentation (Ctrl+Q / hover) for function calls and completion items -->
        <lang.documentationProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.documentation.QuarkdownDocumentationProvider"/>

        <typedHandler implementation="cc.carm.plugin.intellij.quarkdown.lang.QuarkdownTypedHandlerDelegate"/>

        <!-- Enter in Quarkdown files: after a `\` continuation, indent the new line -->
        <enterHandlerDelegate implementation="cc.carm.plugin.intellij.quarkdown.lang.QuarkdownEnterHandlerDelegate"/>

        <annotator
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.annotator.QuarkdownAnnotator"/>

        <!-- Semantic-level syntax highlighting (known functions, variables, enum values) -->
        <annotator
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.annotator.QuarkdownSemanticAnnotator"/>

        <!-- Inlay hints: inline parameter name annotations for positional arguments -->
        <codeInsight.inlayProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.inlay.QuarkdownParameterNameInlayProvider"/>

        <!-- Image path validity check (warn on non-existent paths) -->
        <annotator
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.annotator.QuarkdownImagePathAnnotator"/>

        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.highlighter.QuarkdownSyntaxHighlighterFactory"/>

        <!-- Color settings page -->
        <colorSettingsPage
                implementation="cc.carm.plugin.intellij.quarkdown.lang.highlighter.QuarkdownColorSettingsPage"/>

        <!-- Language commenter (Ctrl+/) -->
        <lang.commenter
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.commenter.QuarkdownCommenter"/>

        <!-- Parser definition (creates Lexer + PSI tree) -->
        <lang.parserDefinition
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.parser.QuarkdownParserDefinition"/>

        <!-- Creates ContributedReferenceHost leaf elements so PsiReferenceService consults
             our PsiReferenceContributor (Ctrl+Click / Find Usages see .ref/.var references) -->
        <lang.ast.factory
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.parser.QuarkdownASTFactory"/>

        <!-- Gutter icon for image lines -->
        <codeInsight.lineMarkerProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.marker.QuarkdownImageLineMarkerProvider"/>

        <!-- Gutter icon for table blocks -->
        <codeInsight.lineMarkerProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.table.QuarkdownTableLineMarkerProvider"/>

        <!-- Gutter icon for code blocks (fenced and .code function blocks) -->
        <codeInsight.lineMarkerProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.marker.QuarkdownCodeBlockLineMarkerProvider"/>

        <!-- Gutter icon for equations (inline and fenced) -->
        <codeInsight.lineMarkerProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.marker.QuarkdownEquationLineMarkerProvider"/>

        <!-- Gutter icon for headings (# … ######) -->
        <codeInsight.lineMarkerProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.marker.QuarkdownHeadingLineMarkerProvider"/>

        <!-- Floating table editor buttons (+row, +col, alignment) -->
        <codeInsight.inlayProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.table.QuarkdownTableEditorProvider"/>
        <!-- Floating formatting toolbar shown on text selection -->
        <textEditorCustomizer
                implementation="cc.carm.plugin.intellij.quarkdown.ui.floating.FloatingToolbarCustomizer"/>
        <!-- Makes the floating toolbar customizable in Settings -->
        <customizableActionGroupProvider
                implementation="cc.carm.plugin.intellij.quarkdown.ui.floating.FloatingToolbarGroupProvider"/>



        <!-- Go-to-declaration / find-usages for .ref {id}, .var {name} and file/image paths -->
        <psi.referenceContributor
                language="Quarkdown"
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownReferenceContributor"/>

        <!-- Find Usages (Alt+F7) support for Quarkdown elements -->
        <lang.findUsagesProvider
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownFindUsagesProvider"/>

        <!-- Standard Find Usages / Show Usages handler for .ref {id} / {#id} / .var -->
        <findUsagesHandlerFactory
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownFindUsagesHandlerFactory"
                order="first"/>

        <!-- Rename refactoring (Shift+F6) for .ref {id} / {#id} labels -->
        <renamePsiElementProcessor
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownRenameProcessor"/>

        <!-- Accept Quarkdown ids (with hyphens) in the Rename dialog validation -->
        <renameInputValidator
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownRenameInputValidator"/>

        <!-- Pre-fill the Rename dialog with the bare id (leaves are not PsiNamedElement) -->
        <nameSuggestionProvider
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownNameSuggestionProvider"/>

        <!-- Ctrl+Click on a {#id} label pops up all .ref usages -->
        <gotoDeclarationHandler
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownGotoDeclarationHandler"/>

        <!-- Show the custom Show Usages popup on Ctrl+Click over a label declaration -->
        <editorFactoryMouseListener
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownEditorMouseListener"
                order="first"/>

        <!-- Provides a searchable word for Quarkdown text leaves so the word-based
             reference search can discover .ref/.var usages -->
        <elementDescriptionProvider
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownElementDescriptionProvider"
                order="first"/>

        <!-- Find Usages for plain-text Quarkdown elements (the default CachesBasedRefSearcher
             only searches by word for PsiNamedElement targets; our leaves are not named) -->
        <referencesSearch
                implementation="cc.carm.plugin.intellij.quarkdown.lang.reference.QuarkdownReferencesSearcher"/>

        <!-- Drag-and-drop image files into Quarkdown editor -->
        <fileDropHandler
                implementation="cc.carm.plugin.intellij.quarkdown.action.image.ImageDropHandler"
                order="first"/>

        <!-- Breadcrumbs navigation showing heading hierarchy -->
        <breadcrumbsInfoProvider
                implementation="cc.carm.plugin.intellij.quarkdown.lang.breadcrumbs.QuarkdownBreadcrumbsProvider"/>

        <!-- Structure View (Alt+7) showing document heading outline -->
        <lang.psiStructureViewFactory
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.structure.QuarkdownStructureViewFactory"/>

        <!-- Code folding for sections, code blocks, and tables -->
        <lang.foldingBuilder
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.fold.QuarkdownFoldingBuilder"/>

        <!-- TODO / FIXME highlighting in comments (shows in IDE TODO panel) -->
        <annotator
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.todo.QuarkdownTodoAnnotator"/>

        <!-- Auto-close paired symbols ({ }, [ ], ( )) with brace matching and navigation -->
        <lang.braceMatcher
                language="Quarkdown"
                implementationClass="cc.carm.plugin.intellij.quarkdown.lang.QuarkdownBraceMatcher"/>

        <!-- Word & paragraph count in the status bar for .qd files -->
        <statusBarWidgetFactory
                id="QuarkdownStats"
                implementation="cc.carm.plugin.intellij.quarkdown.statusbar.QuarkdownStatsWidgetFactory"/>

        <!-- Live preview tool window (JCEF) -->
        <toolWindow
                id="Quarkdown"
                anchor="right"
                factoryClass="cc.carm.plugin.intellij.quarkdown.ui.preview.QuarkdownPreviewToolWindowFactory"
                icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.FILE"/>

        <!-- "Quarkdown Build" run configuration type (executes quarkdown compile with PDF export through the IDE Run tool window) -->
        <configurationType implementation="cc.carm.plugin.intellij.quarkdown.lang.preview.QuarkdownBuildConfigurationType"/>

        <notificationGroup id="Quarkdown" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Quarkdown.NewDocument"
                class="cc.carm.plugin.intellij.quarkdown.action.CreateDocumentAction"
                text="Quarkdown Document"
                description="Create a new Quarkdown document">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>

        <!-- Toolbar of the Quarkdown preview tool window -->
        <group id="Quarkdown.PreviewActions" compact="true" text="Quarkdown Preview" description="Quarkdown preview actions">
            <action id="Quarkdown.Preview.Toggle"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownPreviewToggleAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_PLAY"
                    text="Start Preview"
                    description="Start or stop the live preview server"/>
            <action id="Quarkdown.Preview.View"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownViewPreviewAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_VIEW"
                    text="View in Browser"
                    description="Open the running preview in the external browser"/>
            <separator/>
            <action id="Quarkdown.Preview.Refresh"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownRefreshPreviewAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_REFRESH"
                    text="Refresh"
                    description="Re-compile the current document and refresh the preview">
                <keyboard-shortcut first-keystroke="control alt R" keymap="$default"/>
            </action>
            <action id="Quarkdown.Preview.CleanRefresh"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownCleanRefreshPreviewAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_CLEAN"
                    text="Clean &amp; Refresh"
                    description="Clear the output cache and refresh the preview"/>
            <separator/>
            <action id="Quarkdown.Preview.Build"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownBuildAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_BUILD"
                    text="Build"
                    description="Run the build (PDF export) in the IDE Run tool window"/>
            <action id="Quarkdown.Preview.OpenInBrowser"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownOpenInBrowserAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_BROWSER"
                    text="Open in Browser"
                    description="Open the port-based preview in an external browser"/>
            <separator/>
            <action id="Quarkdown.Preview.WatchChanges"
                    class="cc.carm.plugin.intellij.quarkdown.action.preview.QuarkdownWatchChangesAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.PREVIEW_WATCH"
                    text="Watch Changes"
                    description="Automatically refresh the preview on file changes"/>
        </group>

        <!-- Floating toolbars for row/column operations on Quarkdown tables.
             MUST be in <actions>, not <extensions>, or ActionManager cannot resolve them. -->
        <action id="Quarkdown.Table.FormatTable"
                class="cc.carm.plugin.intellij.quarkdown.action.table.FormatTableAction"
                icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_FORMAT"
                text="Format Table"
                description="Re-align the table"/>
        <group id="Quarkdown.TableActions" compact="true" class="cc.carm.plugin.intellij.quarkdown.action.table.TableActionsGroup">
            <group id="Quarkdown.TableRowActions" compact="true">
                <reference ref="Quarkdown.Table.FormatTable"/>
                <separator/>
                <action id="Quarkdown.Table.SwapRows.SwapWithAbove"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SwapRowsAction$SwapWithAbove"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_MOVE_ROW_UP"
                        text="Move Row Up"
                        description="Move the row up"/>
                <action id="Quarkdown.Table.SwapRows.SwapWithBelow"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SwapRowsAction$SwapWithBelow"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_MOVE_ROW_DOWN"
                        text="Move Row Down"
                        description="Move the row down"/>
                <separator/>
                <action id="Quarkdown.Table.InsertRow.InsertAbove"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.InsertRowAction$InsertAbove"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ADD_ROW_ABOVE"
                        text="Insert Row Above"
                        description="Insert a row above"/>
                <action id="Quarkdown.Table.InsertRow.InsertBelow"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.InsertRowAction$InsertBelow"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ADD_ROW_BELOW"
                        text="Insert Row Below"
                        description="Insert a row below"/>
                <separator/>
                <action id="Quarkdown.Table.SelectRow"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SelectRowAction"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_SELECT"
                        text="Select Row"
                        description="Select the row"/>
                <separator/>
                <action id="Quarkdown.Table.RemoveCurrentRow"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.RemoveCurrentRowAction"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_REMOVE"
                        text="Remove Row"
                        description="Remove the row"/>
            </group>
            <group id="Quarkdown.TableColumnActions" compact="true">
                <reference ref="Quarkdown.Table.FormatTable"/>
                <separator/>
                <action id="Quarkdown.Table.SwapColumns.SwapWithLeftColumn"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SwapColumnsAction$SwapWithLeft"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_MOVE_COLUMN_LEFT"
                        text="Move Column Left"
                        description="Move the column left"/>
                <action id="Quarkdown.Table.SwapColumns.SwapWithRightColumn"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SwapColumnsAction$SwapWithRight"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_MOVE_COLUMN_RIGHT"
                        text="Move Column Right"
                        description="Move the column right"/>
                <separator/>
                <action id="Quarkdown.Table.InsertTableColumn.InsertBefore"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.InsertTableColumnAction$InsertBefore"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ADD_COLUMN_LEFT"
                        text="Insert Column Left"
                        description="Insert a column to the left"/>
                <action id="Quarkdown.Table.InsertTableColumn.InsertAfter"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.InsertTableColumnAction$InsertAfter"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ADD_COLUMN_RIGHT"
                        text="Insert Column Right"
                        description="Insert a column to the right"/>
                <separator/>
                <action id="Quarkdown.Table.SelectCurrentColumn"
                        class="cc.carm.plugin.intellij.quarkdown.action.table.SelectCurrentColumnAction"
                        icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_SELECT"
                        text="Select Column"
                        description="Select the column"/>
                <separator/>
                <group id="Quarkdown.Table.ColumnAlignmentActions"
                       compact="true"
                       class="cc.carm.plugin.intellij.quarkdown.action.table.TableColumnAlignmentActionsGroup">
                    <action id="Quarkdown.Table.SetColumnAlignment.Left"
                            class="cc.carm.plugin.intellij.quarkdown.action.table.SetColumnAlignmentAction$Left"
                            icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ALIGN_LEFT"
                            text="Align Column Left"
                            description="Align the column left"/>
                    <action id="Quarkdown.Table.SetColumnAlignment.Center"
                            class="cc.carm.plugin.intellij.quarkdown.action.table.SetColumnAlignmentAction$Center"
                            icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ALIGN_CENTER"
                            text="Align Column Center"
                            description="Align the column center"/>
                    <action id="Quarkdown.Table.SetColumnAlignment.Right"
                            class="cc.carm.plugin.intellij.quarkdown.action.table.SetColumnAlignmentAction$Right"
                            icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TABLE_ALIGN_RIGHT"
                            text="Align Column Right"
                            description="Align the column right"/>
                </group>
            </group>
        </group>

        <!-- Floating formatting toolbar shown on text selection (mirrors Markdown plugin) -->
        <group id="Quarkdown.Toolbar.Floating" compact="true">
            <action id="Quarkdown.Floating.Bold"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.BoldToggleAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TEXT_BOLD"
                    text="Bold"
                    description="Toggle bold text"/>
            <action id="Quarkdown.Floating.Italic"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.ItalicToggleAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TEXT_ITALIC"
                    text="Italic"
                    description="Toggle italic text"/>
            <action id="Quarkdown.Floating.Strikethrough"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.StrikethroughToggleAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TEXT_STRIKETHROUGH"
                    text="Strikethrough"
                    description="Toggle strikethrough text"/>
            <action id="Quarkdown.Floating.Code"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.CodeToggleAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TEXT_CODE"
                    text="Inline Code"
                    description="Toggle inline code"/>
            <separator/>
            <action id="Quarkdown.Floating.Link"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.LinkInsertAction"
                    icon="cc.carm.plugin.intellij.quarkdown.QuarkdownIcons.TEXT_LINK"
                    text="Link"
                    description="Insert link"/>
        </group>
        <group id="Quarkdown.EditorActions" popup="true" text="Insert" description="Insert Quarkdown elements"
               class="cc.carm.plugin.intellij.quarkdown.action.EditorActionsGroup">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="Quarkdown.ToggleBold"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.BoldToggleAction"
                    text="Bold"
                    description="Toggle bold text">
                <keyboard-shortcut first-keystroke="control B" keymap="$default"/>
            </action>
            <action id="Quarkdown.ToggleItalic"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.ItalicToggleAction"
                    text="Italic"
                    description="Toggle italic text">
                <keyboard-shortcut first-keystroke="control I" keymap="$default"/>
            </action>
            <action id="Quarkdown.ToggleStrikethrough"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.StrikethroughToggleAction"
                    text="Strikethrough"
                    description="Toggle strikethrough text">
                <keyboard-shortcut first-keystroke="control shift S" keymap="$default"/>
            </action>
            <action id="Quarkdown.ToggleCode"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.CodeToggleAction"
                    text="Code"
                    description="Toggle inline code">
                <keyboard-shortcut first-keystroke="control shift C" keymap="$default"/>
            </action>
            <action id="Quarkdown.InsertCodeBlock"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.CodeBlockInsertAction"
                    text="Code Block"
                    description="Insert code block">
                <keyboard-shortcut first-keystroke="control shift B" keymap="$default"/>
            </action>
            <action id="Quarkdown.InsertLink"
                    class="cc.carm.plugin.intellij.quarkdown.action.text.LinkInsertAction"
                    text="Link"
                    description="Insert link">
                <keyboard-shortcut first-keystroke="control shift L" keymap="$default"/>
            </action>
            <action id="Quarkdown.InsertImage"
                    class="cc.carm.plugin.intellij.quarkdown.action.image.ImageInsertAction"
                    text="Image"
                    description="Insert image">
                <keyboard-shortcut first-keystroke="control shift I" keymap="$default"/>
            </action>
            <action id="Quarkdown.InsertTable"
                    class="cc.carm.plugin.intellij.quarkdown.action.table.InsertTableAction"
                    text="Table"
                    description="Insert table">
                <keyboard-shortcut first-keystroke="control shift T" keymap="$default"/>
            </action>
        </group>
    </actions>
</idea-plugin>
